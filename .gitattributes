# 换行：按内容自动判定，但批处理必须是 CRLF，二进制一律不碰
* text=auto

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.zip binary
*.exe binary
*.bin binary

# 文档与脚本统一 LF，避免 diff 里全是空行变化
*.md text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.css text eol=lf
*.html text eol=lf
