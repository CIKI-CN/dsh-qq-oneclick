{
  "name": "dsh-qq-oneclick",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "DSH一键式接入QQ — 非官方一键安装器：本地 Web 向导 + 功能勾选 + 设置中心",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node installer/server.mjs",
    "wizard": "node installer/server.mjs --open",
    "install:test": "node installer/lib/install.mjs --target ../_install_test",
    "pin": "node scripts/fetch-pins.mjs",
    "build": "node scripts/build.mjs",
    "check:notice": "node scripts/check-notice.mjs",
    "gen:notice": "node scripts/gen-notice.mjs",
    "selftest": "node installer/lib/detect.mjs --self-test",
    "check": "node scripts/check-syntax.mjs && node scripts/check-notice.mjs"
  }
}
